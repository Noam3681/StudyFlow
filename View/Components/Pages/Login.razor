
@page "/login"
@using System.Net
@using Model
@inject HttpClient Http
@inject UserSession Session
@inject NavigationManager Navigation

<PageTitle>כניסה · StudyFlow</PageTitle>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-5">

            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-4 p-md-5">
                    <h1 class="h2 fw-bold">כניסה ל־StudyFlow</h1>

                    <p class="text-secondary mb-4">
                        היכנסו לחשבון כדי להמשיך לנהל את הלימודים שלכם.
                    </p>

                    @* השדות מחוברים למשתנים בקוד באמצעות קישור דו-כיווני *@
                    <form novalidate>
                        <Field Id="login-username"
                               Label="שם משתמש"
                               Name="username"
                               @bind-Value="username" />

                        <Field Id="login-password"
                               Label="סיסמה"
                               Name="password"
                               Type="password"
                               Dir="ltr"
                               @bind-Value="password" />

                        @* הצגת הודעת שגיאה רק כאשר קיימת שגיאה *@
                        @if (errorMessage != null)
                        {
                            <div class="alert alert-danger" role="alert">
                                @errorMessage
                            </div>
                        }

                        @* הפעלת ההתחברות ומניעת לחיצות חוזרות בזמן הבדיקה *@
                        <button class="btn btn-primary btn-lg w-100 mt-2"
                                type="button"
                                disabled="@isBusy"
                                @onclick="LoginAsync">
                            @(isBusy ? "בודקים..." : "כניסה")
                        </button>
                    </form>
                </div>
            </div>

            <p class="text-center mt-4">
                אין לך חשבון?
                <a class="fw-bold" href="register">להרשמה</a>
            </p>

        </div>
    </div>
</div>

@code {
    // פרטי ההתחברות שהמשתמש מקליד.
    private string? username;
    private string? password;

    // הודעת שגיאה ומצב שליחת הבקשה.
    private string? errorMessage;
    private bool isBusy;

    // פעולה שמופעלת כאשר לוחצים על כפתור הכניסה.
    private async Task LoginAsync()
    {
        errorMessage = null;

        // בודקים ששני השדות מולאו לפני הפנייה לשרת.
        if (string.IsNullOrWhiteSpace(username) || string.IsNullOrWhiteSpace(password))
        {
            errorMessage = "יש למלא שם משתמש וסיסמה.";
            return;
        }

        isBusy = true;

        try
        {
            // מכינים את פרטי ההתחברות לשליחה לשרת.
            var credentials = new
            {
                Username = username.Trim(),
                Password = password
            };

            HttpResponseMessage response =
                await Http.PostAsJsonAsync("api/users/login", credentials);

            // קוד 401 מציין ששם המשתמש או הסיסמה שגויים.
            if (response.StatusCode == HttpStatusCode.Unauthorized)
            {
                errorMessage = "שם המשתמש או הסיסמה שגויים.";
                return;
            }

            // טיפול בשגיאה אחרת שהשרת החזיר.
            if (!response.IsSuccessStatusCode)
            {
                errorMessage = "הכניסה נכשלה. נסו שוב.";
                return;
            }

            // מקבלים מהשרת את פרטי המשתמש שהתחבר.
            User? user = await response.Content.ReadFromJsonAsync<User>();

            if (user == null)
            {
                errorMessage = "הכניסה נכשלה. נסו שוב.";
                return;
            }

            // שומרים את המשתמש בשירות כדי ששאר הדפים יכירו אותו.
            Session.Login(user);

            // V8: מפנים כל משתמש לדף הבית המתאים לתפקיד שלו.
            // משתמש מסוג Admin מועבר לדף המנהל.
            if (user.Role == "Admin")
            {
                Navigation.NavigateTo("/admin-home");
            }
            // משתמש מסוג Student מועבר לדף התלמיד.
            else if (user.Role == "Student")
            {
                Navigation.NavigateTo("/student-home");
            }
            // משתמש מסוג Teacher מועבר לדף המורה.
            else if (user.Role == "Teacher")
            {
                Navigation.NavigateTo("/teacher-home");
            }
            // תפקיד לא מוכר מועבר לדף הבית הכללי.
            else
            {
                Navigation.NavigateTo("/");
            }
        }
        catch (HttpRequestException)
        {
            // טיפול במקרה שה-API אינו זמין.
            errorMessage = "השרת לא זמין כרגע. נסו שוב בעוד רגע.";
            return;
        }
        finally
        {
            // מחזירים את הכפתור למצב רגיל בסיום הבקשה.
            isBusy = false;
        }
    }
}
