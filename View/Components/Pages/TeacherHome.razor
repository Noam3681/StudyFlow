
@page "/teacher-home"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject View.Services.UserSession Session
@inject NavigationManager Navigation

@* V8: רק משתמש מחובר בעל תפקיד Teacher יכול לראות את הדף. *@

@if (Session.IsLoggedIn && Session.RoleName == "Teacher")
{
    @* V9: אזור ברכה אישי למורה. *@
    <section class="container py-4">
        <div class="bg-white border rounded-4 shadow-sm p-4 p-md-5">
            <p class="text-primary fw-semibold mb-2">
                האזור האישי שלך
            </p>

            <h1 class="display-6 fw-bold mb-3">
                שלום, @Session.Username!
            </h1>

            <p class="lead text-secondary mb-0">
                ברוכים הבאים לאזור המורה ב־StudyFlow.
                כאן תוכלו לנהל את סביבת ההוראה שלכם במקום אחד.
            </p>
        </div>
    </section>

    @* V9: כרטיסיות המציגות את האזורים המרכזיים של המורה. *@
    @* שימוש ברכיב InfoCard המשותף במקום שכפול קוד HTML. *@
    <section class="container py-4">
        <h2 class="fw-bold mb-4">
            סביבת ההוראה שלי
        </h2>

        <div class="row g-4">

            @* V9: כרטיסייה ראשונה - מקצועות לימוד עם קישור לדף הפנימי. *@
            <div class="col-md-4">
                <InfoCard
                    Title="מקצועות הלימוד"
                    Description="כאן תוכלו לצפות במקצועות הלימוד ולארגן את המידע הקשור אליהם."
                    LinkUrl="/teacher-subjects"
                    LinkText="לצפייה במקצועות הלימוד" />
            </div>

            @* V9: כרטיסייה שנייה - משימות ומבחנים עם קישור לדף הפנימי. *@
            <div class="col-md-4">
                <InfoCard
                    Title="משימות ומבחנים"
                    Description="כאן תוכלו לנהל משימות, עבודות ומבחנים הקשורים ללימודים."
                    LinkUrl="/teacher-tasks"
                    LinkText="לצפייה במשימות ובמבחנים" />
            </div>

            @* V9: כרטיסייה שלישית - חומרי לימוד עם קישור לדף הפנימי. *@
            <div class="col-md-4">
                <InfoCard
                    Title="חומרי לימוד"
                    Description="כאן תוכלו לארגן סיכומים, קישורים וחומרי לימוד לפי מקצועות."
                    LinkUrl="/teacher-materials"
                    LinkText="לצפייה בחומרי הלימוד" />
            </div>

        </div>
    </section>

    @* V9: אזור מידע נוסף בתחתית הדף. *@
    <section class="container py-4">
        <div class="bg-white border rounded-4 p-4">
            <h2 class="h4 fw-bold mb-3">
                מתכננים את ההוראה
            </h2>

            <p class="text-secondary mb-0">
                בהמשך תוכלו לנהל את המידע הלימודי,
                לעקוב אחר הפעילויות ולארגן את סביבת ההוראה
                בצורה נוחה ומסודרת.
            </p>
        </div>
    </section>
}

@code {
    // V8: בודקים את מצב ההתחברות ואת תפקיד המשתמש לפני הצגת הדף.
    protected override void OnInitialized()
    {
        // אורח שלא התחבר מועבר לדף ההתחברות.
        if (!Session.IsLoggedIn)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        // משתמש מחובר שאינו מורה מועבר לדף "אין הרשאה".
        if (Session.RoleName != "Teacher")
        {
            Navigation.NavigateTo("/access-denied");
        }
    }
}
